{
  "version": 1,
  "note": "Shared by the Python and the TypeScript metadata appliers. `policyOverride` replaces keys of the policy file for that case only.",
  "cases": [
    {"name": "empty notebook metadata", "level": "notebook", "input": {}, "expected": {}, "dropped": []},
    {"name": "kernelspec and language_info are dropped", "level": "notebook",
     "input": {"kernelspec": {"name": "python3", "display_name": "Python 3"}, "language_info": {"name": "python", "version": "3.12.1"}, "title": "x"},
     "expected": {"title": "x"}, "dropped": ["kernelspec", "language_info"]},
    {"name": "notebook keeps papermill, widgets and unknown keys", "level": "notebook",
     "input": {"papermill": {"parameters": {"a": 1}}, "widgets": {"state": {}}, "my_tool": [1, 2, {"k": null}]},
     "expected": {"papermill": {"parameters": {"a": 1}}, "widgets": {"state": {}}, "my_tool": [1, 2, {"k": null}]}, "dropped": []},
    {"name": "cell keeps tags, slideshow, collapsed, scrolled and parameters", "level": "cell",
     "input": {"tags": ["parameters", "hide-input"], "slideshow": {"slide_type": "fragment"}, "collapsed": true, "scrolled": "auto", "jupyter": {"source_hidden": true}, "papermill": {"status": "completed"}, "custom": {"x": 1}},
     "expected": {"tags": ["parameters", "hide-input"], "slideshow": {"slide_type": "fragment"}, "collapsed": true, "scrolled": "auto", "jupyter": {"source_hidden": true}, "papermill": {"status": "completed"}, "custom": {"x": 1}}, "dropped": []},
    {"name": "cell execution timing keys and trusted are dropped, the empty execution goes", "level": "cell",
     "input": {"trusted": true, "tags": ["a"], "execution": {"iopub.execute_input": "2026-01-01T00:00:00Z", "iopub.status.busy": "t", "iopub.status.idle": "t", "shell.execute_reply": "t", "shell.execute_reply.started": "t"}},
     "expected": {"tags": ["a"]},
     "dropped": ["execution.iopub.execute_input", "execution.iopub.status.busy", "execution.iopub.status.idle", "execution.shell.execute_reply", "execution.shell.execute_reply.started", "trusted"]},
    {"name": "an unknown key inside execution survives", "level": "cell",
     "input": {"execution": {"iopub.execute_input": "t", "mine": 1}},
     "expected": {"execution": {"mine": 1}}, "dropped": ["execution.iopub.execute_input"]},
    {"name": "execution that is not an object is left alone", "level": "cell",
     "input": {"execution": "odd"}, "expected": {"execution": "odd"}, "dropped": []},
    {"name": "kernelspec on a cell is ordinary metadata", "level": "cell",
     "input": {"kernelspec": {"name": "x"}, "trusted": false},
     "expected": {"kernelspec": {"name": "x"}}, "dropped": ["trusted"]},
    {"name": "a value over the limit becomes a marker", "level": "notebook",
     "policyOverride": {"maxValueBytes": 20},
     "input": {"small": "abc", "big": "0123456789012345678901234567890123456789"},
     "expected": {"small": "abc", "big": {"blaymDropped": "too_large", "bytes": 42}}, "dropped": ["big"]},
    {"name": "the limit counts UTF-8 bytes", "level": "cell",
     "policyOverride": {"maxValueBytes": 8},
     "input": {"a": "ééé", "b": "ééééé"},
     "expected": {"a": "ééé", "b": {"blaymDropped": "too_large", "bytes": 12}}, "dropped": ["b"]}
  ]
}
