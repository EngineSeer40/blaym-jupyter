{
    "name": "blaym-vscode",
    "displayName": "Blaym for Jupyter",
    "description": "History, replay and branching for notebooks in VS Code",
    "version": "0.1.0",
    "private": true,
    "publisher": "blaym",
    "license": "MIT",
    "engines": {
        "vscode": "^1.95.0"
    },
    "main": "./out/vscode/src/extension.js",
    "activationEvents": [
        "onNotebook:jupyter-notebook"
    ],
    "contributes": {
        "commands": [
            {
                "command": "blaym.toggleRecording",
                "title": "Blaym: record this notebook"
            }
        ],
        "configuration": {
            "title": "Blaym",
            "properties": {
                "blaym.servicePython": {
                    "type": "string",
                    "default": "",
                    "description": "Python interpreter that runs Blaym's service. When empty, the repository's .venv is used (development)."
                }
            }
        }
    },
    "scripts": {
        "build": "tsc -p .",
        "clean": "rimraf out tsconfig.tsbuildinfo",
        "lint": "prettier --check src",
        "test": "jest"
    },
    "devDependencies": {
        "@types/node": "^20.17.0",
        "@types/vscode": "1.95.0",
        "blaym-notebook-types": "link:../../blaym-notebook-types",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.1",
        "typescript": "~5.5.4"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "endOfLine": "auto",
        "overrides": [
            {
                "files": "package.json",
                "options": {
                    "tabWidth": 4
                }
            }
        ]
    }
}
